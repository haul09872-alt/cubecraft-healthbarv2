  "authors": ["you"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.cchb.CcHealthBarMod"]
  },
  "mixins": ["cubecraft-healthbar.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16.14",
    "minecraft": ">=1.21.7 <1.21.9",
    "java": ">=21",
    "fabric-api": "*"
  }
}
